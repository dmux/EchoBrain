{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window behaviour plus EchoBrain's own IPC commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "allow-search-memories",
    "allow-capture-memory",
    "allow-forget-memory",
    "allow-library",
    "allow-list-memories",
    "allow-update-memory",
    "allow-dictation-available",
    "allow-start-dictation",
    "allow-stop-dictation",
    "allow-audio-level",
    "allow-login-sso",
    "allow-answering-available",
    "allow-speech-available",
    "allow-classify-intent",
    "allow-ask-memories",
    "allow-speak",
    "allow-stop-speaking",
    "allow-available-voices",
    "allow-get-settings",
    "allow-set-settings",
    "allow-get-connection",
    "allow-set-connection",
    "allow-conversation-available",
    "allow-start-conversation",
    "allow-stop-conversation",
    "allow-stop-and-measure-voice",
    "allow-get-voice-profile",
    "allow-save-voice-profile"
  ]
}
